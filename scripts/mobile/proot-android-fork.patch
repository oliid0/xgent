--- a/src/tracee/seccomp.c
+++ b/src/tracee/seccomp.c
@@ -1,4 +1,5 @@
 #include <errno.h>     /* E*, */
+#include <sched.h>     /* CLONE_VM, CLONE_VFORK */
 #include <signal.h>    /* SIGSYS, */
 #include <unistd.h>    /* getpgid, */
 #include <utime.h>     /* utimbuf, */
@@ -155,6 +156,21 @@
 	}
 
 	switch (sysnum) {
+	case PR_fork:
+	case PR_vfork:
+		/* Android permits clone but traps the legacy x86 fork syscalls.
+		 * Retry through the normal PRoot clone path; never fake success.
+		 * A null child stack preserves fork/vfork's caller stack semantics. */
+		set_sysnum(tracee, PR_clone);
+		poke_reg(tracee, SYSARG_1, SIGCHLD |
+			(sysnum == PR_vfork ? CLONE_VM | CLONE_VFORK : 0));
+		poke_reg(tracee, SYSARG_2, 0);
+		poke_reg(tracee, SYSARG_3, 0);
+		poke_reg(tracee, SYSARG_4, 0);
+		poke_reg(tracee, SYSARG_5, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
 	case PR_open:
 		set_sysnum(tracee, PR_openat);
 		poke_reg(tracee, SYSARG_4, peek_reg(tracee, CURRENT, SYSARG_3));
