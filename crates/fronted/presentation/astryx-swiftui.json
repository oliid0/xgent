{
  "version": 2,
  "astryxVersion": "0.6.0",
  "rendering": {
    "applicationUI": "SwiftUI",
    "webContent": "WebKitOnly",
    "businessState": "Shared TypeScript and Tauri Rust",
    "liquidGlass": "Native on iOS 26 and macOS 26; regularMaterial polyfill on macOS 15-25",
    "transportWebView": "Noninteractive and accessibility-hidden while a native root is mounted"
  },
  "contract": {
    "schema": "xgent.presentation.v1",
    "unknownComponent": "reject-document",
    "unknownProperty": "reject-document",
    "missingRenderer": "reject-generation",
    "stateOwnership": "TypeScript owns business state; SwiftUI owns only ephemeral focus, disclosure and presentation state",
    "actionOwnership": "Every interactive native node dispatches a validated typed action to the shared TypeScript handler",
    "webBoundary": "WebKit may render remote browser content only and must never render application chrome"
  },
  "propertyMappings": {
    "label": { "wireType": "string", "swift": "Text/Label/accessibilityLabel according to component contract" },
    "text": { "wireType": "string", "swift": "Text, AttributedString markdown, placeholder or supporting text" },
    "value": { "wireType": "string|number|boolean|null", "swift": "typed Binding backed by XgentPresentationModel" },
    "action": { "wireType": "string", "swift": "validated XgentAction dispatched to the shared TypeScript handler" },
    "disabled": { "wireType": "boolean", "swift": ".disabled plus busy-state gating" },
    "destructive": { "wireType": "boolean", "swift": "ButtonRole.destructive and destructive semantic color" },
    "prominent": { "wireType": "boolean", "swift": "glassProminent or borderedProminent style" },
    "secure": { "wireType": "boolean", "swift": "SecureField instead of TextField" },
    "secondary": { "wireType": "boolean", "swift": "secondary semantic foreground or reduced emphasis" },
    "spacing": { "wireType": "length", "swift": "stack/container spacing in points", "range": [0, 1024] },
    "padding": { "wireType": "length", "swift": ".padding(_:)", "range": [0, 1024] },
    "indent": { "wireType": "length", "swift": ".padding(.leading, _:)", "range": [0, 1024] },
    "fill": { "wireType": "boolean", "swift": ".frame(maxWidth:maxHeight:)" },
    "alignment": { "wireType": "leading|center|trailing", "swift": "stack and frame Alignment" },
    "width": { "wireType": "length", "swift": ".frame(width:)", "range": [0, 10000] },
    "minWidth": { "wireType": "length", "swift": ".frame(minWidth:)", "range": [0, 10000] },
    "maxWidth": { "wireType": "length", "swift": ".frame(maxWidth:)", "range": [0, 10000] },
    "height": { "wireType": "length", "swift": ".frame(height:)", "range": [0, 10000] },
    "minHeight": { "wireType": "length", "swift": ".frame(minHeight:)", "range": [0, 10000] },
    "maxHeight": { "wireType": "length", "swift": ".frame(maxHeight:)", "range": [0, 10000] },
    "maxLines": { "wireType": "integer", "swift": ".lineLimit(_:)", "range": [1, 10000] },
    "wrap": { "wireType": "boolean", "swift": "fixedSize and multiline behavior" },
    "variant": { "wireType": "string", "swift": "semantic variant resolved by the component renderer" },
    "size": { "wireType": "small|medium|large", "swift": "token-mapped controlSize and typography metrics" },
    "icon": { "wireType": "string", "swift": "Image(systemName:) through the checked icon vocabulary" },
    "selected": { "wireType": "boolean", "swift": "selection state, checkmark and accessibility selected trait" },
    "role": { "wireType": "user|assistant|system", "swift": "chat alignment, surface and accessibility sender context" },
    "status": { "wireType": "pending|running|completed|error|paused", "swift": "semantic progress icon, color and accessibility value" },
    "language": { "wireType": "string", "swift": "code language or media MIME type" },
    "minimum": { "wireType": "number", "swift": "Slider/Stepper lower bound" },
    "maximum": { "wireType": "number", "swift": "Slider/Stepper upper bound" },
    "step": { "wireType": "positive-number", "swift": "Slider/Stepper stride" },
    "current": { "wireType": "number", "swift": "ProgressView current value" },
    "total": { "wireType": "nonnegative-number", "swift": "ProgressView total value" },
    "options": { "wireType": "unique-option-array", "swift": "Picker/Menu/FilePicker choices" },
    "accessibilityLabel": { "wireType": "string", "swift": ".accessibilityLabel" },
    "accessibilityHint": { "wireType": "string", "swift": ".accessibilityHint" },
    "accessibilityValue": { "wireType": "string", "swift": ".accessibilityValue" },
    "children": { "wireType": "node-array", "swift": "recursive native view tree with depth and count limits" }
  },
  "eventMappings": {
    "press": { "payload": "null", "kinds": ["Button", "Menu", "NavigationRow", "IconButton", "TreeRow", "ActivityPreview"] },
    "changeText": { "payload": "string", "kinds": ["TextInput", "TextArea", "ComposerInput"] },
    "changeColor": { "payload": "hex-color", "kinds": ["ColorInput"] },
    "changeSelection": { "payload": "string", "kinds": ["Selector", "SegmentedControl"] },
    "changeBoolean": { "payload": "boolean", "kinds": ["Switch"] },
    "changeNumber": { "payload": "number", "kinds": ["Slider"] },
    "pickFiles": { "payload": "serialized-file-array", "kinds": ["FilePicker"] },
    "reportViewport": { "payload": "validated-geometry-json", "kinds": ["BrowserViewport"] },
    "dismiss": { "payload": "null", "kinds": [], "scope": "document" }
  },
  "renderStrategies": {
    "native": {
      "policy": "Direct SwiftUI control or layout; no HTML/WebView fallback",
      "kinds": ["VStack", "HStack", "ScrollView", "Section", "Text", "Heading", "Button", "TextInput", "ColorInput", "TextArea", "Switch", "Selector", "SegmentedControl", "Menu", "Divider", "Progress", "ProgressBar", "Badge", "Banner", "EmptyState", "StatusDot", "Slider", "Collapsible", "Markdown", "CodeBlock", "List", "TreeRow", "NavigationRow", "IconButton", "Spacer", "ComposerInput", "ChatMessage", "Thinking", "ToolCall", "TaskStep"]
    },
    "polyfill": {
      "policy": "SwiftUI composition reproducing Astryx geometry, tokens, states and motion",
      "kinds": ["Card", "SettingsGroup", "SettingsLayout", "Composer", "ChatLayout", "ActivityPreview", "TaskProgress", "BrowserLayout"]
    },
    "systemBridge": {
      "policy": "Native framework view embedded inside SwiftUI; never application WebView UI",
      "kinds": ["BrowserViewport", "MediaPreview", "FilePicker"]
    }
  },
  "platforms": {
    "ios": { "renderer": "SwiftUI", "formFactor": "mobile", "desktopOnlyFeatures": false },
    "macos": { "renderer": "SwiftUI", "formFactor": "desktop", "desktopOnlyFeatures": true },
    "android": { "renderer": "Astryx", "formFactor": "mobile", "desktopOnlyFeatures": false },
    "windows": { "renderer": "Astryx", "formFactor": "desktop", "desktopOnlyFeatures": true },
    "linux": { "renderer": "Astryx", "formFactor": "desktop", "desktopOnlyFeatures": true }
  },
  "templates": {
    "mobileChat": "ChatLayout > toolbar + ChatMessageList + activityStrip + ChatComposer",
    "mobileSidebar": "sidebar > search + skills + MCP + files + workspaces + recents + new chat + settings",
    "mobileMore": "sheet > terminal + shell management + browser + browser settings + git review + SSH + background tasks",
    "activityStrip": "HStack > ActivityPreview + Spacer + TaskProgress",
    "settings": "sheet > appearance + providers + permissions + voice + other + local/cloud + backup + memory + skills + about",
    "workspaceFile": "BrowserLayout > toolbar + guarded TextArea or MediaPreview + metadata",
    "browser": "BrowserLayout > navigation controls + BrowserViewport(WebKit web content only)",
    "confirmation": "alert > explanatory Text + destructive/primary action + cancel"
  },
  "frameworks": {
    "SwiftUI": "application presentation, controls, layout, navigation, accessibility and Liquid Glass",
    "WebKit": "browser page content only; never application chrome",
    "PDFKit": "PDF workspace preview",
    "AVKit": "audio and video workspace preview",
    "PhotosUI": "privacy-preserving photo selection",
    "UniformTypeIdentifiers": "file-picker type contracts",
    "EventKit": "permission-gated calendar and reminder actions",
    "Speech": "permission-gated native mobile dictation",
    "HealthKit": "fine-grained health authorization when provisioned",
    "UserNotifications": "permission-gated local notifications",
    "CloudKit": "Apple private-database sync when provisioned",
    "MessageUI": "user-approved mail composition only; no arbitrary Mail inbox access"
  },
