{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Xgent",
        "width": 1600,
        "height": 1000,
        "minWidth": 320,
        "minHeight": 360,
        "visible": false,
        "backgroundColor": "#f7f7f5",
        "backgroundThrottling": "disabled",
        "decorations": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32-windows.png",
      "icons/128x128-windows.png",
      "icons/128x128@2x-windows.png",
      "icons/icon-windows.png",
      "icons/icon-windows.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon-windows.ico"
      }
    }
  }
}
