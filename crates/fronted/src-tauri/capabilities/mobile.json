{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-execution",
  "description": "Capability used only by the bundled Android and iOS application.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "browser-automation:default",
    "mobile-assistant:default",
    "mobile-execution:default",
    "opener:default"
  ]
}
