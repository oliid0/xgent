{
  "name": "xgent",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test test/**/*.test.mjs",
    "test:non-native": "node --test --test-skip-pattern=\"Tauri backend cargo test suite passes\" test/**/*.test.mjs",
    "check": "tsc --noEmit",
    "test:frontend": "node --test test/settings/*.test.mjs test/chat/*.test.mjs test/debug/*.test.mjs test/memory/*.test.mjs test/providers/*.test.mjs test/subagents/*.test.mjs test/tools/*.test.mjs test/i18n/*.test.mjs test/skills/*.test.mjs test/input-context-menu/*.test.mjs",
    "test:backend": "node --test test/backend/*.test.mjs",
    "test:release": "node --test test/backend/release-*.test.mjs",
    "export:models": "node ./test/get-providers-get-models-example.js --save",
    "lint": "biome check --diagnostic-level=error --max-diagnostics=none src/",
    "format": "biome format --write src/",
    "lint:fix": "biome check --write src/"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-matcha": "0.5.4",
    "@astryxdesign/theme-neutral": "0.5.4",
    "@astryxdesign/theme-stone": "0.5.4",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@iconify-json/gravity-ui": "^1.2.14",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "eventsource-parser": "^4.1.0",
    "jszip": "3.10.2",
    "katex": "^0.18.7",
    "monaco-editor": "^0.56.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptx-preview": "1.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "typebox": "1.3.30",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.4",
    "@biomejs/biome": "^2.5.12",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/material-icon-theme": "1.2.70",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "typescript-transpile": "npm:typescript@~6.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "node-domexception": "npm:empty-npm-package@1.0.0",
      "uuid": "^11.0.0"
    },
    "onlyBuiltDependencies": [
      "@astryxdesign/cli",
      "@astryxdesign/core",
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  }
}
